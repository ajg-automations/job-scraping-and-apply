# Copy to .env and fill in real values. NEVER commit .env.
# Tools read these at runtime. Add a new var here whenever a tool needs one.

# --- ATS public APIs ---
# Greenhouse & Lever job-board APIs are public per-company; usually no key needed.
# Set the company board tokens/slugs you target (comma-separated).
GREENHOUSE_BOARD_TOKENS=
LEVER_COMPANY_SLUGS=

# --- Job aggregator APIs ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=          # USAJOBS requires your contact email as User-Agent
JSEARCH_RAPIDAPI_KEY=

# --- Academic boards ---
# HigherEdJobs / AcademicJobsOnline — fill if/when an API key is obtained.
HIGHEREDJOBS_API_KEY=
ACADEMICJOBSONLINE_API_KEY=

# --- trigger.dev (backend) ---
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# --- Frontend ↔ backend ---
# Public trigger access / signed endpoint used by the Vercel frontend.
TRIGGER_PUBLIC_ACCESS_TOKEN=

# --- Ranking / summarization (Claude API) ---
ANTHROPIC_API_KEY=
