# Secrets — never commit
.env
.env.*
!.env.example

# WAT working area — safe to wipe (keep the dirs, ignore their contents)
temp/outputs/*
temp/resources/*
!temp/outputs/.gitkeep
!temp/resources/.gitkeep

# Node
node_modules/
dist/
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# trigger.dev / Vercel
.trigger/
.vercel/
.next/
